package http

import (
	"crypto/subtle"
	"errors"
	"fmt"
	"net/http"
	"strings"

	"github.com/labstack/echo/v5"
	"github.com/labstack/echo/v5/middleware"

	"{{ .ModuleName }}/config"
	"{{ .ModuleName }}/internal/lib/log"
	redisv9 "{{ .ModuleName }}/internal/lib/redis"
	"{{ .ModuleName }}/internal/models/vo"
	"{{ .ModuleName }}/utils"
)

type EchoMiddleware struct {
	config              config.Config
	cache               *redisv9.Client
	defaultErrorHandler echo.HTTPErrorHandler
}

func (e *EchoMiddleware) CORS(h echo.HandlerFunc) echo.HandlerFunc {
	cors := middleware.CORSWithConfig(middleware.CORSConfig{
		AllowOrigins: e.config.Server.CORSOrigins,
		AllowMethods: []string{
			http.MethodDelete,
			http.MethodGet,
			http.MethodPost,
			http.MethodPut,
			http.MethodOptions,
			http.MethodHead,
			http.MethodPatch,
		},
	})
	return cors(h)
}

func (e *EchoMiddleware) Recover(h echo.HandlerFunc) echo.HandlerFunc {
	return middleware.Recover()(h)
}

func (e *EchoMiddleware) Logger(h echo.HandlerFunc) echo.HandlerFunc {
	return func(c *echo.Context) error {
		log.Logger.Infof(
			"request method=%s path=%s userAgent=%q",
			c.Request().Method,
			c.Request().URL.Path,
			c.Request().UserAgent(),
		)
		return h(c)
	}
}

func (e *EchoMiddleware) JWT(next echo.HandlerFunc) echo.HandlerFunc {
	return func(c *echo.Context) error {
		if e.isPublicURI(c.Request().URL.Path) {
			return next(c)
		}

		token, err := e.extractBearerToken(c.Request().Header.Get(echo.HeaderAuthorization))
		if err != nil {
			return c.JSON(http.StatusUnauthorized, vo.ErrorResp(http.StatusUnauthorized, "认证失败"))
		}

		claims, err := utils.ParseToken(token, e.config.Key.JWT.Secret, e.config.Key.JWT.Issuer)
		if err != nil || e.cache == nil {
			return c.JSON(http.StatusUnauthorized, vo.ErrorResp(http.StatusUnauthorized, "认证失败"))
		}

		cacheKey := fmt.Sprintf("jwt:user:%d", claims.UserID)
		cacheToken, err := e.cache.Get(c.Request().Context(), cacheKey).Result()
		if err != nil || subtle.ConstantTimeCompare([]byte(cacheToken), []byte(token)) != 1 {
			return c.JSON(http.StatusUnauthorized, vo.ErrorResp(http.StatusUnauthorized, "认证失败"))
		}

		c.Set("user_id", claims.UserID)
		c.Set("user_email", claims.Email)
		return next(c)
	}
}

func (e *EchoMiddleware) AccessAuth(next echo.HandlerFunc) echo.HandlerFunc {
	return func(c *echo.Context) error {
		if e.isPublicURI(c.Request().URL.Path) {
			return next(c)
		}

		accessKey := c.Request().Header.Get("access_key")
		secretKey := c.Request().Header.Get("secret_key")
		accessMatch := subtle.ConstantTimeCompare([]byte(accessKey), []byte(e.config.Key.AK.AccessKey)) == 1
		secretMatch := subtle.ConstantTimeCompare([]byte(secretKey), []byte(e.config.Key.AK.SecretKey)) == 1
		if !accessMatch || !secretMatch {
			return c.JSON(http.StatusUnauthorized, vo.ErrorResp(http.StatusUnauthorized, "认证失败"))
		}
		return next(c)
	}
}

func (e *EchoMiddleware) ErrorHandler(c *echo.Context, err error) {
	report, ok := errors.AsType[*echo.HTTPError](err)
	if !ok {
		report = echo.NewHTTPError(http.StatusInternalServerError, http.StatusText(http.StatusInternalServerError))
	}
	log.Logger.Errorf(
		"request failed method=%s path=%s status=%d err=%v",
		c.Request().Method,
		c.Request().URL.Path,
		report.StatusCode(),
		err,
	)
	e.defaultErrorHandler(c, err)
}

func (e *EchoMiddleware) isPublicURI(uri string) bool {
	return uri == "/" ||
		uri == "/health" ||
		uri == "/login" ||
		uri == "/swagger" ||
		strings.HasPrefix(uri, "/swagger/")
}

func (e *EchoMiddleware) extractBearerToken(authorization string) (string, error) {
	authType, token, ok := strings.Cut(strings.TrimSpace(authorization), " ")
	if !ok || !strings.EqualFold(authType, "Bearer") || strings.TrimSpace(token) == "" {
		return "", errors.New("invalid authorization header")
	}
	return strings.TrimSpace(token), nil
}

func InitMiddleware(c config.Config, cache *redisv9.Client) *EchoMiddleware {
	return &EchoMiddleware{
		config:              c,
		cache:               cache,
		defaultErrorHandler: echo.DefaultHTTPErrorHandler(c.Debug),
	}
}

package example_srv

import (
	"context"
	"errors"
	"time"

	"go.mongodb.org/mongo-driver/v2/bson"

	"{{ .ModuleName }}/internal/lib/log"
	do "{{ .ModuleName }}/internal/models/do/mongo/example_do"
	"{{ .ModuleName }}/internal/models/vo"
	"{{ .ModuleName }}/internal/repository/mongo/example_repo"
	"{{ .ModuleName }}/utils"
)

type UserMongoService interface {
	GetByID(ctx context.Context, id string) (vo.MongoUserView, error)
	List(ctx context.Context, page, pageSize int) (vo.UserMongoListResp, error)
	Create(ctx context.Context, req vo.CreateMongoUserReq) (vo.MongoUserView, error)
	Update(ctx context.Context, id string, req vo.UpdateUserReq) (vo.UserMongoIDResp, error)
	Delete(ctx context.Context, id string) (vo.UserMongoIDResp, error)
}

type UserMongoServiceImpl struct {
	repo           example_repo.UserRepository
	contextTimeout time.Duration
}

func NewUserMongoService(repo example_repo.UserRepository, timeout time.Duration) (UserMongoService, error) {
	if repo == nil {
		return nil, errors.New("user repository is nil")
	}
	if timeout <= 0 {
		return nil, errors.New("context timeout must be positive")
	}
	return &UserMongoServiceImpl{
		repo:           repo,
		contextTimeout: timeout,
	}, nil
}

func (s *UserMongoServiceImpl) view(user *do.User)vo.MongoUserView{return vo.MongoUserView{ID:user.ID.Hex(),Name:user.Name,Email:user.Email}}
func (s *UserMongoServiceImpl) GetByID(ctx context.Context,id string)(vo.MongoUserView,error){
 objectID,err:=bson.ObjectIDFromHex(id);if err!=nil{return vo.MongoUserView{},utils.ErrBadParamInput}
 ctx,cancel:=context.WithTimeout(ctx,s.contextTimeout);defer cancel()
 user,err:=s.repo.GetByID(ctx,objectID);if err!=nil{return vo.MongoUserView{},err};return s.view(user),nil
}

func (s *UserMongoServiceImpl) List(ctx context.Context, page, pageSize int) (resp vo.UserMongoListResp, err error) {
	log.FromContext(ctx).Debugf("[UserMongoSrv.List] page[%d] pageSize[%d] start", page, pageSize)
	if err = vo.ValidateBaseList(page, pageSize); err != nil {
		log.FromContext(ctx).Warnf("[UserMongoSrv.List] page[%d] pageSize[%d] validate error: %v", page, pageSize, err)
		return resp, err
	}

	ctx, cancel := context.WithTimeout(ctx, s.contextTimeout)
	defer cancel()
	offset := int64((page - 1) * pageSize)
	limit := int64(pageSize)
	cond := bson.M{"isDeleted": bson.M{"$ne": true}}
	users, total, err := s.repo.GetByCondAndPage(ctx, cond, offset, limit)
	if err != nil {
		log.FromContext(ctx).Error("user list failed")
		return resp, err
	}
	views:=make([]vo.MongoUserView,0,len(users));for _,user:=range users{views=append(views,s.view(user))}
resp = vo.UserMongoListResp{
		Total: total,
		List:  views,
	}
	log.FromContext(ctx).Infof("[UserMongoSrv.List] page[%d] pageSize[%d] total[%d] success", page, pageSize, total)
	return resp, nil
}

func (s *UserMongoServiceImpl) Create(ctx context.Context,req vo.CreateMongoUserReq)(vo.MongoUserView,error){
 if err:=req.Validate();err!=nil{return vo.MongoUserView{},err}
 ctx,cancel:=context.WithTimeout(ctx,s.contextTimeout);defer cancel()
 user:=&do.User{Name:req.Name,Email:req.Email}
 if err:=s.repo.Create(ctx,user);err!=nil{return vo.MongoUserView{},err};return s.view(user),nil
}

func (s *UserMongoServiceImpl) Update(ctx context.Context, id string, req vo.UpdateUserReq) (resp vo.UserMongoIDResp, err error) {
	log.FromContext(ctx).Debugf("[UserMongoSrv.Update] id[%s] start", id)
	objectID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		log.FromContext(ctx).Warnf("[UserMongoSrv.Update] id[%s] invalid objectID: %v", id, err)
		return resp, utils.ErrBadParamInput
	}

	if err:=req.Validate();err!=nil{return resp,err}
	updates := bson.M{}
	if req.Name != "" {
		updates["name"] = req.Name
	}
	if req.Email != "" {
		updates["email"] = req.Email
	}
	if len(updates) == 0 {
		log.FromContext(ctx).Warnf("[UserMongoSrv.Update] id[%s] no valid updates", id)
		return resp, utils.ErrBadParamInput
	}

	ctx, cancel := context.WithTimeout(ctx, s.contextTimeout)
	defer cancel()
	if err = s.repo.UpdateByID(ctx, objectID, updates); err != nil {
		log.FromContext(ctx).Error("user update failed")
		return resp, err
	}
	resp = vo.UserMongoIDResp{
		ID: id,
	}
	log.FromContext(ctx).Infof("[UserMongoSrv.Update] id[%s] success", id)
	return resp, nil
}

func (s *UserMongoServiceImpl) Delete(ctx context.Context, id string) (resp vo.UserMongoIDResp, err error) {
	log.FromContext(ctx).Debugf("[UserMongoSrv.Delete] id[%s] start", id)
	objectID, err := bson.ObjectIDFromHex(id)
	if err != nil {
		log.FromContext(ctx).Warnf("[UserMongoSrv.Delete] id[%s] invalid objectID: %v", id, err)
		return resp, utils.ErrBadParamInput
	}

	ctx, cancel := context.WithTimeout(ctx, s.contextTimeout)
	defer cancel()
	if err = s.repo.DeleteByID(ctx, objectID); err != nil {
		log.FromContext(ctx).Error("user delete failed")
		return resp, err
	}
	resp = vo.UserMongoIDResp{
		ID: id,
	}
	log.FromContext(ctx).Infof("[UserMongoSrv.Delete] id[%s] success", id)
	return resp, nil
}

package common_srv

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"reflect"
	"strconv"
	"time"

	"github.com/prometheus/client_golang/api"
	v1 "github.com/prometheus/client_golang/api/prometheus/v1"
	promModel "github.com/prometheus/common/model"
	"github.com/spf13/cast"

	"{{ .ModuleName }}/config"
)

type PrometheusService interface {
	QueryMemUsage(ctx context.Context, address string) (int, error)
}

type PrometheusServiceImpl struct {
	timeout time.Duration
	v1api   v1.API
}

func NewPrometheusService(c config.Config) (PrometheusService, error) {
	clientConfig := api.Config{Address: c.Prometheus.URL}
	if c.Prometheus.Token != "" {
		clientConfig.RoundTripper = bearerTransport{
			base:  http.DefaultTransport,
			token: c.Prometheus.Token,
		}
	}
	client, err := api.NewClient(clientConfig)
	if err != nil {
		return nil, fmt.Errorf("create prometheus client: %w", err)
	}
	return &PrometheusServiceImpl{timeout: c.Prometheus.Timeout, v1api: v1.NewAPI(client)}, nil
}

func (p *PrometheusServiceImpl) QueryMemUsage(ctx context.Context, address string) (int, error) {
	if address == "" {
		return 0, fmt.Errorf("prometheus instance address is required")
	}
	labelValue := strconv.Quote(address)
	promQL := fmt.Sprintf(
		`java_lang_Memory_HeapMemoryUsage_used{instance=%s}/java_lang_Memory_HeapMemoryUsage_max{instance=%s} * 100`,
		labelValue,
		labelValue,
	)
	vector, err := p.queryVector(ctx, promQL)
	if err != nil {
		return 0, err
	}
	if len(vector) == 0 {
		return 0, errors.New("prometheus returned an empty vector")
	}
	return cast.ToInt(vector[0].Value), nil
}

func (p *PrometheusServiceImpl) queryVector(ctx context.Context, promQL string) (promModel.Vector, error) {
	queryCtx, cancel := context.WithTimeout(ctx, p.timeout)
	defer cancel()
	result, _, err := p.v1api.Query(queryCtx, promQL, time.Now())
	if err != nil {
		return nil, fmt.Errorf("query prometheus: %w", err)
	}
	vector, ok := result.(promModel.Vector)
	if !ok {
		return nil, fmt.Errorf("expected prometheus vector, got %v", reflect.TypeOf(result))
	}
	return vector, nil
}

type bearerTransport struct {
	base  http.RoundTripper
	token string
}

func (t bearerTransport) RoundTrip(req *http.Request) (*http.Response, error) {
	clone := req.Clone(req.Context())
	clone.Header = req.Header.Clone()
	clone.Header.Set("Authorization", "Bearer "+t.token)
	return t.base.RoundTrip(clone)
}

package example_vo

import (
	"net/mail"
	"strings"


	"{{ .ModuleName }}/utils"
)

type CreateUserReq struct {
	Name     string `json:"name" validate:"required"`
	Email    string `json:"email" validate:"required"`
	Password string `json:"password" validate:"required"`
}

type UpdateUserReq struct {
	Name  string `json:"name"`
	Email string `json:"email"`
}

{{- if .MongoDB }}
type CreateMongoUserReq struct {
	Name  string `json:"name"`
	Email string `json:"email"`
}

func (r CreateMongoUserReq) Validate() error {
	if strings.TrimSpace(r.Name) == "" || !validEmail(r.Email) {
		return utils.ErrBadParamInput
	}
	return nil
}
{{- end }}

type LoginReq struct {
	Email    string `json:"email" validate:"required"`
	Password string `json:"password" validate:"required"`
}

type LoginResp struct {
	Token     string `json:"token"`
	ExpiresIn int64  `json:"expiresIn"`
}

func (r CreateUserReq) Validate() error {
	if strings.TrimSpace(r.Name) == "" || len(r.Password) < 8 || len(r.Password)>72 || !validEmail(r.Email) {
		return utils.ErrBadParamInput
	}
	return nil
}

func (r UpdateUserReq) Validate() error {
	if strings.TrimSpace(r.Name) == "" && strings.TrimSpace(r.Email) == "" {
		return utils.ErrBadParamInput
	}
	if r.Email != "" && !validEmail(r.Email) {
		return utils.ErrBadParamInput
	}
	return nil
}

func (r LoginReq) Validate() error {
	if r.Password == "" || !validEmail(r.Email) {
		return utils.ErrBadParamInput
	}
	return nil
}

func validEmail(value string) bool {
	address, err := mail.ParseAddress(value)
	return err == nil && address.Address == value
}

{{- if .MySQL }}
type UserListResp struct {
	Total int64          `json:"total"`
	List  []UserView `json:"list"`
}
{{- end }}

{{- if .MongoDB }}
type UserMongoListResp struct {
	Total int64           `json:"total"`
	List  []MongoUserView `json:"list"`
}
{{- end }}

type UserIDResp struct {
	ID int64 `json:"id"`
}

{{- if .MongoDB }}
type UserMongoIDResp struct {
	ID string `json:"id"`
}
{{- end }}

// UserView 不包含密码哈希或持久化元数据。
type UserView struct { ID int64 `json:"id"`; Name string `json:"name"`; Email string `json:"email"` }
type MongoUserView struct { ID string `json:"id"`; Name string `json:"name"`; Email string `json:"email"` }

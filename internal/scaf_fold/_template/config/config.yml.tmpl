---
debug: true
contextTimeout: 10s

server:
    address: ":8080"
    readHeaderTimeout: 5s
    readTimeout: 15s
    writeTimeout: 15s
    idleTimeout: 60s
    shutdownTimeout: 10s
    maxBodyBytes: 1048576
    corsOrigins:
        - "http://localhost:3000"

{{- if .MySQL }}
database:
    driver: "mysql"
    host: "127.0.0.1"
    port: 3306
    database: "test"
    username: "root"
    password: ""
    maxIdleConns: 20
    maxOpenConns: 100
    connMaxLifetime: 5m
    charset: "utf8mb4"
    timeZone: "Local"
    name: "db_test"

{{- end }}
redis:
    name: "test"
    proto: "tcp"
    addr: "127.0.0.1:6379"
    auth: ""
    db: 0
    dialTimeout: 5s
    readTimeout: 1s
    writeTimeout: 1s
    slowLog: 200ms
    pool:
        active: 100
        idle: 10
        waitTimeout: 2s
        wait: true

{{- if .MongoDB }}
mongodb:
    uri: "mongodb://127.0.0.1:27017"
    authSource: "admin"
    user: ""
    password: ""
    database: "test"
    maxPoolSize: 20
    minPoolSize: 2
    connectTimeout: 5s

{{- end }}
prometheus:
    url: "http://127.0.0.1:9090"
    token: ""
    timeout: 5s

lark:
    appID: ""
    appSecret: ""
    timeout: 10s

log:
    fileName: "logs/{{ .ProjectName }}.log"
    logLevel: 0
    maxSizeMB: 20
    maxBackupCount: 30
    maxKeepDays: 7

key:
    type: "none"
    basic:
        user: ""
        password: ""
    ak:
        accessKey: ""
        secretKey: ""
    jwt:
        secret: ""
        expire: 2h
        issuer: "{{ .ProjectName }}"

cron:
    on: false
    lockTTL: 30s

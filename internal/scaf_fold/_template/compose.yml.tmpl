# 仅用于本机隔离联调；端口绑定环回地址。按需开启 profile。
services:
  app:
    build: .
    ports:
      - "127.0.0.1:${APP_PORT:-18080}:8080"
    environment:
      APP_KEY_AK_ACCESSKEY: "${APP_KEY_AK_ACCESSKEY:-}"
      APP_KEY_AK_SECRETKEY: "${APP_KEY_AK_SECRETKEY:-}"
{{ if .MySQL }}
      APP_DATABASE_ENABLED: "${APP_DATABASE_ENABLED:-false}"
      APP_DATABASE_PASSWORD: "${MYSQL_PASSWORD:-}"
{{ end }}
{{ if .MongoDB }}
      APP_MONGODB_ENABLED: "${APP_MONGODB_ENABLED:-false}"
{{ end }}
{{ if .Redis }}
      APP_REDIS_ENABLED: "${APP_REDIS_ENABLED:-false}"
{{ end }}
{{ if .MySQL }}
  mysql:
    image: mysql:8.4
    profiles: [mysql]
    ports:
      - "127.0.0.1:${MYSQL_PORT:-13306}:3306"
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
      MYSQL_DATABASE: test
      MYSQL_USER: app
      MYSQL_PASSWORD: "${MYSQL_PASSWORD:-}"
    healthcheck:
      test: [CMD, mysqladmin, ping, --host=127.0.0.1, --silent]
      interval: 2s
      timeout: 3s
      retries: 40
    volumes:
      - mysql-data:/var/lib/mysql
{{ end }}
{{ if .MongoDB }}
  mongo:
    image: mongo:8.0
    profiles: [mongodb]
    ports:
      - "127.0.0.1:${MONGO_PORT:-17017}:27017"
    healthcheck:
      test: [CMD, mongosh, --quiet, --eval, "db.adminCommand({ping: 1})"]
      interval: 2s
      timeout: 3s
      retries: 40
    volumes:
      - mongo-data:/data/db
{{ end }}
{{ if .Redis }}
  redis:
    image: redis:8.2-alpine
    profiles: [redis]
    ports:
      - "127.0.0.1:${REDIS_PORT:-16379}:6379"
    command: [redis-server, --appendonly, "no"]
    healthcheck:
      test: [CMD, redis-cli, ping]
      interval: 2s
      timeout: 3s
      retries: 40
{{ end }}
{{ if or .MySQL .MongoDB }}
volumes:
{{ if .MySQL }}
  mysql-data:
{{ end }}
{{ if .MongoDB }}
  mongo-data:
{{ end }}
{{ end }}
